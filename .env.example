# EXPLICIT LOCAL DEMO ONLY. Set false in production; SQLite is demo-only.
DEMO_MODE=true
DEBUG=false
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:8000
# Native host using Compose db/redis:
DATABASE_URL=postgres://caas:local-only-change-me@127.0.0.1:5434/caas
REDIS_URL=redis://127.0.0.1:6381/0
POSTGRES_PASSWORD=local-only-change-me
# true only for the no-Redis native demo; use false with worker/beat.
CELERY_TASK_ALWAYS_EAGER=false
OPENAI_API_KEY=
CHAT_MODEL=
EMBEDDING_MODEL=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Use legacy raw-body HMAC only if your account has no new signing secret.
PAYSTACK_ALLOW_LEGACY_SIGNATURE=false
# USD micro-dollar hard ceilings, unrelated to NGN plan prices.
# Set conservative per-token UPPER BOUNDS for your chosen models; include FX/tax outside this budget.
REQUEST_COST_MICROUSD=100000
INPUT_MICROUSD_PER_TOKEN=1
OUTPUT_MICROUSD_PER_TOKEN=5
EMBED_MICROUSD_PER_TOKEN=1
MAX_ORG_STORAGE_BYTES=20971520
